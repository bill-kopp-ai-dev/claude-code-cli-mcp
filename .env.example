# Claude Code CLI MCP server — example environment variables
# Copy to .env and adjust as needed.
# All variables use the prefix CLAUDE_MCP_.

# Runtime mode: "safe" (default) or "permissive"
CLAUDE_MCP_MODE=safe

# Comma or JSON list of allowed workspace roots.
CLAUDE_MCP_ALLOWED_ROOTS=["/path/to/your/projects"]

# Path to the `claude` binary. If empty, `shutil.which("claude")` is used.
CLAUDE_MCP_CLAUDE_PATH=claude

# Fallback paths to search for the `claude` binary.
# CLAUDE_MCP_CLAUDE_PATH_FALLBACKS=["/usr/local/bin/claude","/opt/homebrew/bin/claude","~/.local/bin/claude"]

# Hardening
CLAUDE_MCP_FORCE_BARE=true
CLAUDE_MCP_FORCE_SANDBOX_IN_SAFE_MODE=true
CLAUDE_MCP_DEFAULT_PERMISSION_MODE=acceptEdits

# Limits
CLAUDE_MCP_DEFAULT_TIMEOUT_S=600
CLAUDE_MCP_POLL_DEFAULT_WAIT_SECONDS=0.5
CLAUDE_MCP_MAX_CONCURRENT_RUNS=10
CLAUDE_MCP_MAX_RUNS=50
CLAUDE_MCP_MAX_STDOUT_BYTES=1000000
CLAUDE_MCP_MAX_STDERR_BYTES=200000

# Models allowed by --model flag (empty = any).
CLAUDE_MCP_ALLOWED_MODELS=sonnet,fable,opus,haiku
CLAUDE_MCP_TIMEOUT_POLICY_ENABLED=false
CLAUDE_MCP_TIMEOUT_POLICY_DEFAULT_MAX_S=3600
CLAUDE_MCP_TIMEOUT_POLICY_FLOOR_S=60

# Permissive-mode allowlists (safe mode rejects all env and extra_args)
CLAUDE_MCP_ALLOW_ENV_KEYS=[]
CLAUDE_MCP_ALLOW_EXTRA_ARGS=[]

# Persistence layer (AGENTS.md, PROJECTS.md, MEMORY.md)
# Default storage location is ~/.open-cli-router/claude-code/ ("global").
# Set CLAUDE_MCP_PERSISTENCE_LOCATION=workspace to store under <cwd_parent>/.open-cli-router/
# (one level above the server's CWD — useful for per-project memory).
# Custom paths supported via $cwd_parent token in CLAUDE_MCP_PERSISTENCE_BASE_DIR.
CLAUDE_MCP_PERSISTENCE_ENABLED=true
CLAUDE_MCP_PERSISTENCE_LOCATION=global
CLAUDE_MCP_PERSISTENCE_BASE_DIR=~/.open-cli-router
# CLAUDE_MCP_PERSISTENCE_BASE_DIR=$cwd_parent/.open-cli-router   # workspace example
# CLAUDE_MCP_PERSISTENCE_BASE_DIR=$cwd_parent/.my-persistence    # custom escape hatch
CLAUDE_MCP_PERSISTENCE_MAX_FILE_BYTES=524288
CLAUDE_MCP_PERSISTENCE_BACKUP_ON_WRITE=false
CLAUDE_MCP_PERSISTENCE_BACKUP_KEEP=10
CLAUDE_MCP_PERSISTENCE_SEED_TEMPLATES=true
CLAUDE_MCP_PERSISTENCE_TRUNCATION_HEAD_RATIO=0.2

# Logfire (observability) — optional. Leave empty to disable.
# CLAUDE_MCP_LOGFIRE_TOKEN=